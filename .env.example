# Keep this file safe to commit. Put real credentials only in .env.
GEMINI_API_KEY=

# Selected free-tier model and conservative application limits. These limits
# reserve 20% headroom below the confirmed account quotas (15 RPM, 250k TPM,
# 1,500 RPD) and will be enforced when Gemini is introduced in Phase 5.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_RPM=12
GEMINI_MAX_TPM=200000
GEMINI_MAX_RPD=1200

# Paths are relative to the repository root unless made absolute.
DATA_DIR=data
DERIVED_DIR=backend/derived
